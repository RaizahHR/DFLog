Use cLoggerDatabase.pkg
Use cLoggerFile.pkg
Use cLoggerEventLog.pkg
Use cJsonObject.pkg

Define C_DFLOG_DEFAULT_EVENTCODE for 100

Class cLogger is a cObject
    Procedure Construct_Object
        Forward Send Construct_Object

        Property String psApplicationName ""
        Property Integer piEventCode C_DFLOG_DEFAULT_EVENTCODE
        Property String psLastError ""
        Property Boolean pbDebugErrorsEnabled True

        Property Integer Private_piLogLevel DFLOG_INFO
        Property Handle[] phoaLoggerWorkers

        { Visibility=Private }
        Property Boolean Private_pbIsWriting False
    End_Procedure

    { MethodType=Property }
    Procedure Set piLogLevel Integer iLogLevel
        If ((iLogLevel < DFLOG_NONE) or (iLogLevel > DFLOG_INFO)) Begin
            Send ReportProgrammingLogError "Logger" ("Invalid piLogLevel " + String(iLogLevel) + ;
                ". Expected DFLOG_NONE, DFLOG_ERRORS, DFLOG_WARNINGS, or DFLOG_INFO.")
            Procedure_Return
        End

        Set Private_piLogLevel to iLogLevel
    End_Procedure

    { MethodType=Property }
    Function piLogLevel Returns Integer
        Function_Return (Private_piLogLevel(Self))
    End_Function

    Function LogLevelEnabled Integer iMessageLogLevel Returns Boolean
        Function_Return (piLogLevel(Self) >= iMessageLogLevel)
    End_Function

    Procedure ReportLogError String sSink String sMessage
        Set psLastError to (sSink + ": " + sMessage)
        Send OnLogError sSink sMessage
    End_Procedure

    Procedure ReportProgrammingLogError String sSink String sMessage
        String sError

        Send ReportLogError sSink sMessage
        If (pbDebugErrorsEnabled(Self)) Begin
            Move ("DFLog " + sSink + ": " + sMessage) to sError
            Error DFERR_PROGRAM sError
        End
    End_Procedure

    { MethodType=Event }
    Procedure OnLogError String sSink String sMessage
    End_Procedure

    Function GetLoggerApplicationName Returns String
        Handle hoWorkspace
        String sName

        Get psApplicationName to sName
        If ((sName = "") and (ghoApplication <> 0)) Begin
            Get phoWorkspace of ghoApplication to hoWorkspace
            If (hoWorkspace <> 0) ;
                Get psWorkspaceName of hoWorkspace to sName
            If (sName = "") ;
                Get GetApplicationName of ghoApplication to sName
        End
        If (sName = "") ;
            Move "DataFlex" to sName

        Send OnGetLoggerApplicationName (&sName)
        Function_Return sName
    End_Function

    { MethodType=Event }
    Procedure OnGetLoggerApplicationName String ByRef sName
    End_Procedure

    Function GetEventCode Returns Integer
        Integer iCode

        Get piEventCode to iCode
        Send OnGetEventCode (&iCode)
        Function_Return iCode
    End_Function

    { MethodType=Event }
    Procedure OnGetEventCode Integer ByRef iCode
    End_Procedure

    Function FormatLogTimestamp DateTime dtTimeStamp Returns String
        String sTimeStamp

        Move (String(DateGetYear(dtTimeStamp))) to sTimeStamp
        Move (sTimeStamp + "-" + Right("0" + String(DateGetMonth(dtTimeStamp)), 2)) to sTimeStamp
        Move (sTimeStamp + "-" + Right("0" + String(DateGetDay(dtTimeStamp)), 2)) to sTimeStamp
        Move (sTimeStamp + "T" + Right("0" + String(DateGetHour(dtTimeStamp)), 2)) to sTimeStamp
        Move (sTimeStamp + ":" + Right("0" + String(DateGetMinute(dtTimeStamp)), 2)) to sTimeStamp
        Move (sTimeStamp + ":" + Right("0" + String(DateGetSecond(dtTimeStamp)), 2)) to sTimeStamp
        Move (sTimeStamp + "." + Right("00" + String(DateGetMillisecond(dtTimeStamp)), 3)) to sTimeStamp
        Function_Return sTimeStamp
    End_Function

    Function LogLevelName Integer iMessageLogLevel Returns String
        If (iMessageLogLevel = DFLOG_ERRORS) ;
            Function_Return "error"
        If (iMessageLogLevel = DFLOG_WARNINGS) ;
            Function_Return "warning"

        Function_Return "info"
    End_Function

    Function SerializeAdditionalData Handle hoAdditionalFields Returns String
        Boolean bIsJsonObject bIsObject
        String sAdditionalData

        If (hoAdditionalFields = 0) ;
            Function_Return ""

        Move (IsObjectOfClass(hoAdditionalFields, RefClass(cJsonObject))) to bIsJsonObject
        If (not(bIsJsonObject)) Begin
            Send ReportProgrammingLogError "Logger" "Additional log fields must be supplied as a cJsonObject."
            Function_Return ""
        End

        Get IsOfJsonType of hoAdditionalFields jsonTypeObject to bIsObject
        If (not(bIsObject)) Begin
            Send ReportProgrammingLogError "Logger" "Additional log fields must have a JSON object as their root."
            Function_Return ""
        End

        Get Stringify of hoAdditionalFields to sAdditionalData
        Function_Return sAdditionalData
    End_Function

    Function JsonObjectMember Handle hoJson String sMemberName Returns Handle
        Boolean bIsObject
        Handle hoMember

        Get IsMemberOfJsonType of hoJson sMemberName jsonTypeObject to bIsObject
        If (bIsObject) ;
            Get Member of hoJson sMemberName to hoMember
        Else Begin
            Get Create (RefClass(cJsonObject)) to hoMember
            Send InitializeJsonType of hoMember jsonTypeObject
            Send SetMember of hoJson sMemberName hoMember
        End

        Function_Return hoMember
    End_Function

    Function FormatLogLine DateTime dtTimeStamp String sCategory String sMessage Integer iCode Integer iMessageLogLevel String sTraceId String sAdditionalData Returns String
        Boolean bParsed
        Handle hoJson hoEcs hoLog hoService hoEvent hoTrace
        String sLine sApplication sLevel sTimeStamp

        Get GetLoggerApplicationName to sApplication
        Get LogLevelName iMessageLogLevel to sLevel
        Get FormatLogTimestamp dtTimeStamp to sTimeStamp

        Get Create (RefClass(cJsonObject)) to hoJson
        If (Trim(sAdditionalData) <> "") ;
            Get ParseString of hoJson sAdditionalData to bParsed
        If (not(bParsed)) ;
            Send InitializeJsonType of hoJson jsonTypeObject

        Get JsonObjectMember hoJson "ecs" to hoEcs
        Get JsonObjectMember hoJson "log" to hoLog
        Get JsonObjectMember hoJson "service" to hoService
        Get JsonObjectMember hoJson "event" to hoEvent

        Send SetMemberValue of hoJson "@timestamp" jsonTypeString sTimeStamp
        Send SetMemberValue of hoJson "message" jsonTypeString sMessage
        Send SetMemberValue of hoEcs "version" jsonTypeString C_DFLOG_ECS_VERSION
        Send SetMemberValue of hoLog "level" jsonTypeString sLevel
        Send SetMemberValue of hoService "name" jsonTypeString sApplication
        Send SetMemberValue of hoEvent "action" jsonTypeString sCategory
        Send SetMemberValue of hoEvent "code" jsonTypeString (String(iCode))

        Move (Trim(sTraceId)) to sTraceId
        If (sTraceId <> "") Begin
            Get JsonObjectMember hoJson "trace" to hoTrace
            Send SetMemberValue of hoTrace "id" jsonTypeString sTraceId
        End

        Get Stringify of hoJson to sLine
        If (hoTrace <> 0) ;
            Send Destroy of hoTrace
        Send Destroy of hoEvent
        Send Destroy of hoService
        Send Destroy of hoLog
        Send Destroy of hoEcs
        Send Destroy of hoJson
        Function_Return sLine
    End_Function

    Procedure InitLogger
        Boolean bEnabled bReady
        Handle hoWorker
        Handle[] hoaWorkers
        Integer i

        Broadcast Send CollectLoggerWorker (&hoaWorkers)
        Set phoaLoggerWorkers to hoaWorkers

        For i from 0 to (SizeOfArray(hoaWorkers) - 1)
            Move hoaWorkers[i] to hoWorker
            Set phoLogger of hoWorker to Self
            Get pbEnabled of hoWorker to bEnabled
            If (bEnabled) ;
                Get InitWorker of hoWorker to bReady
            Else ;
                Send DeinitWorker of hoWorker
        Loop
    End_Procedure

    Procedure WriteLog DateTime dtTimeStamp String sCategory String sMessage Integer iOptCode Integer iOptMessageLogLevel String sOptTraceId Handle hoOptAdditionalFields
        Boolean bEnabled bOldErr bReady bWorkerEnabled
        Handle hoWorker
        Handle[] hoaWorkers
        Integer i iCode iMessageLogLevel
        String sAdditionalData

        If (Private_pbIsWriting(Self)) ;
            Procedure_Return

        Move iOptMessageLogLevel to iMessageLogLevel
        If ((iMessageLogLevel < DFLOG_ERRORS) or (iMessageLogLevel > DFLOG_INFO)) ;
            Move DFLOG_INFO to iMessageLogLevel
        Get LogLevelEnabled iMessageLogLevel to bEnabled
        If (not(bEnabled)) ;
            Procedure_Return

        Move Err to bOldErr
        Set Private_pbIsWriting to True
        Set psLastError to ""

        Move iOptCode to iCode
        If (iCode = 0) ;
            Get GetEventCode to iCode
        Get SerializeAdditionalData hoOptAdditionalFields to sAdditionalData

        Get phoaLoggerWorkers to hoaWorkers
        For i from 0 to (SizeOfArray(hoaWorkers) - 1)
            Move hoaWorkers[i] to hoWorker
            Get pbEnabled of hoWorker to bWorkerEnabled
            If (bWorkerEnabled) Begin
                Get pbReady of hoWorker to bReady
                If (not(bReady)) ;
                    Get InitWorker of hoWorker to bReady
                If (bReady) ;
                    Send WriteLog of hoWorker dtTimeStamp sCategory sMessage iCode iMessageLogLevel sOptTraceId sAdditionalData
            End
        Loop

        Set Private_pbIsWriting to False
        Move bOldErr to Err
    End_Procedure

    Procedure LogMessage String sCategory String sMessage Integer iOptCode Integer iOptMessageLogLevel String sOptTraceId Handle hoOptAdditionalFields
        Send WriteLog (CurrentDateTime()) sCategory sMessage iOptCode iOptMessageLogLevel sOptTraceId hoOptAdditionalFields
    End_Procedure

    Procedure End_Construct_Object
        Forward Send End_Construct_Object
        Send InitLogger
    End_Procedure
End_Class
