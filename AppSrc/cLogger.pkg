Use VdfBase.pkg

Class cLogger is a cObject
    
    Procedure Construct_Object
        Forward Send Construct_Object
        
        Property Boolean pbWriteToFile      // If True, write any log to the designated log file
        Property Boolean pbWriteToDatabase  // If True, write any log to the designated area in the database
        Property Boolean pbWriteToEventLog  // If True, write any log to the Windows Event Log
        
        // Defaults, can be overridden
        Property Handle phoLogDataDictionary
        Property String psLogTable
        
        Property String psLogFolderPath
        Property Boolean pbLogToSingleFile False // If True, will write everything to one big log file. If false, will separate the log file per day
        Property Integer piEventCode
    End_Procedure
    
    Function GetLogDdoHande Returns Handle
        Handle hoDD
        
        Get phoLogDataDictionary to hoDD
        
        Send OnGetLogDdoHandle (&hoDD)
            
        Function_Return hoDd
    End_Function
    
    {MethodType = Event}
    Procedure OnGetLogDdoHandle Handle ByRef HoDD
        // Stub
    End_Procedure
    
    Function GetLogFilePath Returns String
        String sPath
        
        Get psLogFile to sPath
        
        Send OnGetLogFilePath (&sPath)
            
        Function_Return sPath
    End_Function
    
    {MethodType = Event}
    Procedure OnGetLogFilePath String ByRef sPath
        // Stub
    End_Procedure
    
    Function GetEventCode Returns Integer
        Integer iCode
        
        Get piEventCode to iCode
        
        Send OnGetEventCode (&iCode)
            
        Function_Return iCode
    End_Function
    
    {MethodType = Event}
    Procedure OnGetEventCode Integer ByRef iCode
        // Stub
    End_Procedure
    
    Procedure WriteLog DateTime dtTimeStamp String sCategory String sMessage Integer iOptCode
        If (pbWriteToDatabase(Self)) ;
            Send WriteLogEntryDatabase dtTimeStamp sCategory sMessage iOptCode

        If (pbWriteToFile(Self)) ;
            Send WriteLogEntryFile dtTimeStamp sCategory sMessage iOptCode
            
        If (pbWriteToEventLog(Self)) ;
            Send WriteLogEntryEventLog dtTimeStamp sCategory sMessage 100
    End_Procedure
    
