    // Check if given psLogTable exists
    // Return true if exists, false if missing
    Function TableExists Returns Boolean
    End_Function
    
    // Create table (based on psLogTableName) if it doesn't exist
    // Return 1 if success, 0 if failed
    Function CreateTable Returns Integer
        // Use external SQL script with a parameterized table name for this?
    End_Function
    
    // Check if given psLogFolderPath exists
    // Return true if exists, false if missing
    Function LogFolderExists Returns Boolean
